# ================= ZENIX PUBLIC DASHBOARD =================
PORT=3000
BOT_NAME=ZENIX
BOT_VERSION=1.8.0
BOT_PREFIX=*

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.com/auth/discord/callback

# Same ZENIX bot token used by the bot
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN

# Random long secret for dashboard sessions
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=true

# Bot invite permissions (0 = no privileged permissions preselected)
BOT_INVITE_PERMISSIONS=0

# Public links
SUPPORT_URL=https://discord.gg/YOUR_SUPPORT_SERVER
YOUTUBE_URL=https://www.youtube.com/@shido.code707
